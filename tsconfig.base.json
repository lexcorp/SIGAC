{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@sigac/domain-kernel": [
        "./packages/domain-kernel/src/index.ts"
      ],
      "@sigac/archive-operations": [
        "./packages/modules/archive-operations/src/index.ts"
      ],
      "@sigac/agenda-preparation": [
        "./packages/modules/agenda-preparation/src/index.ts"
      ],
      "@sigac/requests": [
        "./packages/modules/requests/src/index.ts"
      ],
      "@sigac/tenant": [
        "./packages/platform/tenant/src/index.ts"
      ],
      "@sigac/audit": [
        "./packages/platform/audit/src/index.ts"
      ],
      "@sigac/database": [
        "./packages/platform/database/src/index.ts"
      ],
      "@sigac/pdf": [
        "./packages/platform/pdf/src/index.ts"
      ]
    }
  }
}
